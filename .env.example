GEMINI_API_KEY=your_gemini_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here

# Set to true to translate any spoken Indian language directly into English text transcript.
# Set to false to transcribe raw audio in the native spoken language.
STT_TRANSLATE_TO_ENGLISH=true

# Language Configuration for native mode (only active when STT_TRANSLATE_TO_ENGLISH=false)
# e.g., 'hi-IN' for Hindi, 'gu-IN' for Gujarati, or 'auto' for automatic language detection.
VOICE_LANGUAGE_CODE=auto
